# Path to YOLOv8 weights file (relative to backend/ directory)
MODEL_PATH=weights/ppe_v1.pt

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg://username:password@host/database

# Inference device:
# - auto: use the first NVIDIA CUDA GPU when PyTorch can access one, otherwise CPU
# - cpu: force CPU
# - cuda / cuda:0 / 0: force a CUDA GPU
INFERENCE_DEVICE=auto

# Minimum confidence to surface a detection (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.5

# Fraction of the equipment bounding box that must overlap the person bounding box
# for the equipment to be considered "worn" by that person (0.0 – 1.0)
# Lower values = more lenient matching; higher values = stricter matching
PPE_OVERLAP_THRESHOLD=0.3

# Process every Nth video frame. 1 = every frame, 2 = every other frame.
# Higher values are faster but may miss short violations or reduce tracking quality.
VIDEO_FRAME_STRIDE=1

# Video duplicate-case matching. These prevent one physical worker from being
# counted twice if ByteTrack changes the track ID for the same person.
VIDEO_CASE_IOU_THRESHOLD=0.2
VIDEO_CASE_CENTER_DISTANCE_RATIO=0.75
VIDEO_CASE_MAX_FRAME_GAP=90
VIDEO_EDGE_MARGIN_RATIO=0.05
VIDEO_NEW_TRACK_GRACE_SECONDS=0.5
VIDEO_VIOLATION_CONFIRM_SECONDS=0.75
VIDEO_RECENT_PPE_MEMORY_SECONDS=1.5
VIDEO_MIN_PERSON_HEIGHT_RATIO=0.10
VIDEO_STABILITY_WINDOW_FRAMES=5
VIDEO_MAX_CENTER_SHIFT_RATIO=0.35
VIDEO_MAX_SIZE_CHANGE_RATIO=0.45

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
