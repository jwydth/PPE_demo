Project safety_monitoring {
  database_type: "PostgreSQL"
  Note: "Current SQLModel schema for PPE detection and zone monitoring."
}

Table cameras {
  id bigint [pk, increment]
  name varchar(255) [not null]
  source_key varchar(500) [not null, unique, note: "API video_name maps to this field."]
  source_uri varchar [note: "Nullable source location such as an RTSP URL."]
  calibration_source_points jsonb [note: "Legacy nullable field; BEV calibration is not used by the current API."]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

}

Table zones {
  id bigint [pk, increment]
  camera_id bigint [not null]
  name varchar(255) [not null, note: "API zone_name maps to this field."]
  zone_type varchar(32) [not null, note: "RESTRICTED or WALKWAY."]
  dwell_threshold_seconds integer [not null, default: 0]
  is_active boolean [not null, default: true]
  ui_shape_data jsonb [not null, note: "Frontend drawing metadata."]
  normalized_coordinates jsonb [not null, note: "Normalized polygon coordinates."]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    camera_id
  }

  Note: "dwell_threshold_seconds must be nonnegative."
}

Table ppe_violations {
  id bigint [pk, increment]
  camera_id bigint [note: "Nullable. Set to NULL when the camera is deleted."]
  source_key varchar(500) [note: "Nullable copy of the source/video name."]
  occurred_at timestamptz [not null]
  violation_type varchar(64) [not null]
  details text [not null]
  snapshot_path varchar [note: "Nullable MinIO object key."]
  frame_index integer [note: "Nullable and nonnegative when present."]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    camera_id
    source_key
    occurred_at
  }
}

Table ppe_violation_subjects {
  id bigint [pk, increment]
  ppe_violation_id bigint [not null]
  tracker_id bigint [note: "Nullable tracker ID."]
  person_index integer [note: "Nullable and nonnegative when present."]
  missing_equipment jsonb [not null, note: "JSON array such as [\"Helmet\", \"Vest\"]."]
  bounding_box jsonb [note: "Nullable object with x1, y1, x2, and y2."]
  confidence float [note: "Nullable value from 0 to 1."]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    ppe_violation_id
  }
}

Table zone_violations {
  id bigint [pk, increment]
  zone_id bigint [note: "Nullable. Set to NULL when the zone is deleted."]
  zone_name varchar(255) [not null, note: "Copied name retained for history."]
  source_key varchar(500) [not null, note: "API video_name maps to this field."]
  tracker_id bigint [note: "Nullable in the database."]
  occurred_at timestamptz [not null]
  frame_index integer [not null]
  snapshot_path varchar [note: "Nullable MinIO object key."]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    zone_id
    source_key
    occurred_at
  }

  Note: "frame_index must be nonnegative. API zone_type is resolved from the current zone and can be null after zone deletion."
}

Ref: cameras.id < zones.camera_id [delete: restrict]
Ref: cameras.id < ppe_violations.camera_id [delete: set null]
Ref: ppe_violations.id < ppe_violation_subjects.ppe_violation_id [delete: cascade]
Ref: zones.id < zone_violations.zone_id [delete: set null]
