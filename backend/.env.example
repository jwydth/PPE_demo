# Model
MODEL_PATH=weights/ppe_v4.pt
# Runtime device selection. Keep auto for normal GPU/CPU fallback.
# CUDA package choice is controlled by requirements-cuda-cu132.txt,
# not by this env value.
INFERENCE_DEVICE=auto

# Behavior-based fall detection. The classifier needs a complete 60-frame
# pose window; keep the live stride at 1 so its timing matches training.
FALL_MODEL_PATH=weights/pose.pt
FALL_BEHAVIOR_MODEL_PATH=weights/behavior.joblib
FALL_REID_MODEL_PATH=weights/reid.pt
FALL_LIVE_FRAME_STRIDE=1
FALL_BEHAVIOR_PORTABLE_MODEL_PATH=weights/behavior.ubj

# Multi-camera behavior runtime. Keep FALL_LIVE_FRAME_STRIDE=1: the classifier
# requires an ordered 60-sample window on its canonical 24-FPS timeline.
BEHAVIOR_ORDERED_QUEUE_SIZE=180
BEHAVIOR_BATCH_MAX_SIZE=4
BEHAVIOR_CAMERA_BURST_SIZE=2
BEHAVIOR_BATCH_WAIT_MS=4
BEHAVIOR_POSE_IMGSZ=448
BEHAVIOR_FIXED_CAMERA=true
BEHAVIOR_GMC_METHOD=none
BEHAVIOR_REID_HALF=true
BEHAVIOR_REID_INTERVAL_FRAMES=4
BEHAVIOR_LIVE_WARMUP_FRAMES=3
BEHAVIOR_START_COHORT_WAIT_MS=1200
BEHAVIOR_TORCH_THREADS=4
BEHAVIOR_TORCH_INTEROP_THREADS=1
BEHAVIOR_OPENCV_THREADS=4
BEHAVIOR_XGBOOST_THREADS=1
BEHAVIOR_HEALTH_LOG_INTERVAL_SECONDS=10
FALL_BEHAVIOR_WINDOW_FRAMES=60
FALL_BEHAVIOR_WINDOW_STRIDE=12
FALL_BEHAVIOR_CANONICAL_FPS=24
FALL_BEHAVIOR_MIN_CONFIDENCE=0.70
FALL_TRACK_MAX_MISSING_SAMPLES=12
CONFIDENCE_THRESHOLD=0.5
PPE_OVERLAP_THRESHOLD=0.3

# PostgreSQL
DATABASE_URL=postgresql+psycopg://safety_user:safety_password@localhost:5432/safety_monitoring

# MinIO object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=safety-monitoring-evidence
MINIO_SECURE=false

# Temporary local snapshot workspace before upload to MinIO
SNAPSHOT_DIR=storage/snapshots

# Video processing and tracking
VIDEO_FRAME_STRIDE=2
LIVE_PPE_TARGET_FPS=8
ANNOTATED_STREAM_ENABLED=true
ANNOTATED_STREAM_DELAY_SECONDS=3.0
ANNOTATED_STREAM_QUEUE_SIZE=180
ANNOTATED_PPE_TTL_FRAMES=8
ANNOTATED_SIGN_TTL_SECONDS=3.0
ANNOTATED_PPE_MATCH_IOU=0.20
ANNOTATED_RTSP_BASE_URL=rtsp://127.0.0.1:8554
ANNOTATED_PATH_SUFFIX=_annotated
ANNOTATED_FFMPEG_PATH=ffmpeg
ANNOTATED_ENCODER=auto
LIVE_SIGN_TARGET_FPS=1
LIVE_SIGN_PHASE_FRAME=13
BEHAVIOR_POSE_REPAIR_MAX_GAP=8
BEHAVIOR_POSE_REPAIR_MIN_CONFIDENCE=0.10
BEHAVIOR_POSE_REPAIR_MAX_CENTER_SHIFT_RATIO=1.50
VIDEO_TRACKER=bytetrack.yaml
VIDEO_CASE_IOU_THRESHOLD=0.2
VIDEO_CASE_CENTER_DISTANCE_RATIO=0.75
VIDEO_CASE_MAX_FRAME_GAP=90
VIDEO_EDGE_MARGIN_RATIO=0.05
VIDEO_NEW_TRACK_GRACE_SECONDS=0.5
VIDEO_VIOLATION_CONFIRM_SECONDS=0.75
VIDEO_RECENT_PPE_MEMORY_SECONDS=1.5
VIDEO_MIN_PERSON_HEIGHT_RATIO=0.10
VIDEO_STABILITY_WINDOW_FRAMES=5
VIDEO_MAX_CENTER_SHIFT_RATIO=0.35
VIDEO_MAX_SIZE_CHANGE_RATIO=0.45
VIDEO_MIN_CLEAR_PERSON_ASPECT_RATIO=1.20
VIDEO_POSTURE_HEIGHT_DROP_RATIO=0.70
VIDEO_POSTURE_HISTORY_MIN_FRAMES=3

# Frontend origins allowed to call the backend
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Reporting / PDF export
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
REPORT_COMPANY_NAME=De Heus LLC
REPORT_ARCHIVE_TO_MINIO=true

# SMTP email delivery (disabled until configured)
REPORT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=safety-reports@example.com
SMTP_FROM_NAME=Smart Factory Safety Monitoring
REPORT_RECIPIENT_ALLOWLIST=["@deheus.com"]
REPORT_MAX_RECIPIENTS=10
REPORT_EMAIL_RATE_LIMIT_PER_HOUR=20
